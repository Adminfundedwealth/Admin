# ⚠️  SECURITY: Previous keys in this file were EXPOSED and must be rotated.
# Go to Supabase Dashboard → Settings → API → Rotate service_role key NOW.
# Then paste the new values below.

NEXT_PUBLIC_SUPABASE_URL=ROTATE_AND_REPLACE_THIS
NEXT_PUBLIC_SUPABASE_ANON_KEY=ROTATE_AND_REPLACE_THIS
SUPABASE_SERVICE_ROLE_KEY=ROTATE_AND_REPLACE_THIS

# Required for TOTP encryption (generate with: openssl rand -hex 32)
TOTP_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_hex_32

# Required for cron endpoint protection (generate with: openssl rand -hex 32)
CRON_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Required for CSRF and session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Main Website API server (Express on Railway).
# Local dev: http://localhost:9010 (run the api-server from fundedwealth repo)
# Production: set to the Railway public URL (e.g. https://api-server-production-xxxx.up.railway.app)
MAINSITE_API_URL=http://localhost:9010

# Shared secret for Admin → api-server provisioning calls.
# Must match INTERNAL_PROVISION_SECRET in the api-server's .env
INTERNAL_PROVISION_SECRET=dev-internal-secret-change-in-production
