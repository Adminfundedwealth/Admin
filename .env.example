# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Configuration
NEXT_PUBLIC_APP_URL=https://admin.fundedwealth.com
NEXT_PUBLIC_APP_NAME=FundedWealth Admin OS

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars-change-this

# TOTP Encryption (AES-256-GCM for encrypting 2FA secrets at rest)
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-min-32-chars

# Cron Job Authentication
CRON_SECRET=your-cron-secret-min-32-chars

# Terminal Webhook Secret (for receiving lifecycle callbacks from Terminal project)
TERMINAL_WEBHOOK_SECRET=your-terminal-webhook-secret-min-32-chars

# Session Timeouts
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_MAX_AGE_MS=28800000

# Email Service (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@fundedwealth.com
EMAIL_FROM_NAME=FundedWealth

# Outgoing Webhooks (Admin → Main Site / Terminal)
MAINSITE_WEBHOOK_URL=https://fundedwealth.com/api/webhooks/admin
MAINSITE_WEBHOOK_SECRET=your-mainsite-webhook-secret-min-32-chars
TERMINAL_OUTGOING_WEBHOOK_URL=https://terminal.fundedwealth.com/api/webhooks/admin

# Redis (for production rate limiting)
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
